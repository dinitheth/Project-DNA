{
  "name": "vscode-extension",
  "displayName": "Project DNA",
  "description": "Project DNA VS Code Extension",
  "version": "1.0.0",
  "publisher": "project-dna",
  "engines": {
    "vscode": "^1.100.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "project-dna-sidebar",
          "title": "Project DNA",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "project-dna-sidebar": [
        {
          "id": "project-dna.sidebar.webview",
          "name": "DNA Explorer",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "project-dna.analyzeRepository",
        "title": "Analyze Repository",
        "category": "Project DNA"
      },
      {
        "command": "project-dna.refreshDna",
        "title": "Refresh DNA",
        "category": "Project DNA"
      },
      {
        "command": "project-dna.openArchitecture",
        "title": "Open Architecture",
        "category": "Project DNA"
      },
      {
        "command": "project-dna.openKnowledgeGraph",
        "title": "Open Knowledge Graph",
        "category": "Project DNA"
      },
      {
        "command": "project-dna.generateDna",
        "title": "Generate DNA",
        "category": "Project DNA"
      }
    ]
  },
  "dependencies": {
    "@project-dna/shared": "workspace:*",
    "@project-dna/dna-core": "workspace:*",
    "@project-dna/repository-scanner": "workspace:*",
    "@project-dna/ast-engine": "workspace:*",
    "@project-dna/dependency-engine": "workspace:*",
    "@project-dna/architecture-engine": "workspace:*",
    "@project-dna/knowledge-engine": "workspace:*",
    "@project-dna/dna-engine": "workspace:*",
    "@project-dna/software-intelligence-engine": "workspace:*",
    "@project-dna/evolution-engine": "workspace:*",
    "@project-dna/storage": "workspace:*",
    "@project-dna/ui-components": "workspace:*",
    "better-sqlite3": "^12.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.24.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "^1.80.0",
    "@types/node": "^20.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.23.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "vite": "^5.4.0",
    "typescript": "^5.0.0"
  },
  "scripts": {
    "benchmark": "node esbuild.mjs --workers-only && vitest bench --run",
    "build:extension": "node esbuild.mjs",
    "build:webview": "tsc -p webview/tsconfig.json --noEmit && cd webview && vite build",
    "build": "npm run build:extension && npm run build:webview",
    "watch:extension": "node esbuild.mjs --watch",
    "watch:webview": "cd webview && vite build --watch",
    "test": "node esbuild.mjs --workers-only && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "lint": "eslint src/ webview/src/ --max-warnings=0",
    "lint:fix": "eslint src/ webview/src/ --max-warnings=0 --fix",
    "clean": "rimraf dist"
  }
}
