{
  "name": "project-dna-installed-vsix-driver",
  "displayName": "Project DNA Installed VSIX Driver",
  "description": "CI-only driver for validating Project DNA in an installed VS Code Extension Host.",
  "version": "1.0.0",
  "publisher": "project-dna-tests",
  "private": true,
  "engines": {
    "vscode": ">=1.132.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.cjs"
}
